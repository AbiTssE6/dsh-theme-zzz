/**
 * Host half of dsh-theme-zzz.
 *
 * Serves the bundled assets (fonts + logo) so the browser half can use them
 * from CSS and JSX without inlining megabytes into the client bundle.
 */
import { createReadStream } from 'node:fs'
import { stat, writeFile } from 'node:fs/promises'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

const HERE = dirname(fileURLToPath(import.meta.url))
const REPORT_ROUTE = '/zzz-theme/report'
const REPORT_FILE = join(HERE, 'dom-report.json')

/** Temporary diagnostic sink: accepts one JSON body per POST. */
async function receiveReport(req, res) {
  const chunks = []
  let total = 0
  try {
    for await (const chunk of req) {
      total += chunk.length
      if (total > 2 * 1024 * 1024) throw new Error('report too large')
      chunks.push(chunk)
    }
    await writeFile(REPORT_FILE, Buffer.concat(chunks))
    res.setHeader('Content-Type', 'application/json')
    res.end('{"ok":true}')
  } catch (error) {
    res.statusCode = 400
    res.end(String(error))
  }
}
const ROUTES = [
  {
    path: '/zzz-theme/fonts',
    dir: join(HERE, 'fonts'),
    files: {
      'inpin-bold.woff2': 'font/woff2',
      'inpin-d40.woff2': 'font/woff2',
      'noto-sans-sc-regular.woff2': 'font/woff2',
    },
    cache: 'public, max-age=31536000, immutable',
  },
]

/** Build a handler that serves exactly the names in one route table. */
function staticHandler(route) {
  return async function handler(req, res) {
    const path = (req.url ?? '').split('?', 1)[0]
    const name = path.startsWith(`${route.path}/`) ? path.slice(route.path.length + 1) : undefined
    const type = name === undefined ? undefined : route.files[name]
    if (type === undefined) {
      res.statusCode = 404
      res.end('not found')
      return
    }
    const file = join(route.dir, name)
    let info
    try {
      info = await stat(file)
    } catch {
      res.statusCode = 404
      res.end('not found')
      return
    }
    res.setHeader('Content-Type', type)
    res.setHeader('Content-Length', String(info.size))
    res.setHeader('Cache-Control', route.cache)
    res.setHeader('X-Content-Type-Options', 'nosniff')
    if (req.method === 'HEAD') {
      res.end()
      return
    }
    createReadStream(file).pipe(res)
  }
}

export const inject = ['webServer']

export function apply(ctx) {
  for (const route of ROUTES) {
    ctx.effect(
      () =>
        ctx.webServer.register({ kind: 'prefix', path: route.path, handler: staticHandler(route) }),
      `dsh-theme-zzz: ${route.path}`,
    )
  }
  ctx.effect(
    () => ctx.webServer.register({ kind: 'exact', path: REPORT_ROUTE, handler: receiveReport }),
    'dsh-theme-zzz: report route',
  )

}
