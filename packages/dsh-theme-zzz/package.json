{
  "name": "dsh-theme-zzz",
  "version": "0.3.5",
  "description": "Zenless Zone Zero style theme for DeepSeek Harness: palette, typography, brand chrome and the hollow background.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbiTssE6/dsh-theme-zzz.git",
    "directory": "packages/dsh-theme-zzz"
  },
  "homepage": "https://github.com/AbiTssE6/dsh-theme-zzz",
  "bugs": {
    "url": "https://github.com/AbiTssE6/dsh-theme-zzz/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "zenless-zone-zero",
    "zzz"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.4"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/NOTICE.md",
    "FONT-LICENSES.md",
    "CHANGES.md",
    "README.md",
    "LICENSE",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
